# Required. Absolute path to the SQLite database file.
# The application has no default for it: a build without this variable fails
# on purpose, so a stray run can never open the production database.
XBOCT_LOG_DB=C:\Users\you\.xboct-log\xboct-log.db

# Required. Directory with migration files.
XBOCT_LOG_MIGRATIONS=C:\Users\you\.xboct-log\app\migrations

# Required. Directory for database backups.
XBOCT_LOG_BACKUP_DIR=C:\Users\you\.xboct-log\backups

# Optional. The values below are the defaults.
XBOCT_LOG_BACKUP_HOUR=3
XBOCT_LOG_BACKUP_MINUTE=0
XBOCT_LOG_BACKUP_WEEKDAY=0
XBOCT_LOG_BACKUP_DAILY_KEEP=7
XBOCT_LOG_BACKUP_WEEKLY_KEEP=4
XBOCT_LOG_BACKUP_AUTO_KEEP=48
XBOCT_LOG_BACKUP_AUTO_INTERVAL_MIN=30
XBOCT_LOG_BACKUP_DISABLED=0
XBOCT_LOG_ACTIVITY_KEEP_DAYS=365
