# Example values for a manual run. `pnpm dev` sets its own paths and does not
# read this file; `pnpm build` needs no variables at all.
# Relative paths are resolved from the repository root.

# Path to the SQLite database file.
XBOCT_LOG_DB=.dev/dev.db

# Directory with migration files.
XBOCT_LOG_MIGRATIONS=migrations

# Directory for database backups.
XBOCT_LOG_BACKUP_DIR=.dev/backups

# Optional. The values below are the defaults.
XBOCT_LOG_BACKUP_HOUR=3
XBOCT_LOG_BACKUP_MINUTE=0
XBOCT_LOG_BACKUP_WEEKDAY=0
XBOCT_LOG_BACKUP_DAILY_KEEP=7
XBOCT_LOG_BACKUP_WEEKLY_KEEP=4
XBOCT_LOG_BACKUP_AUTO_KEEP=48
XBOCT_LOG_BACKUP_AUTO_INTERVAL_MIN=30
XBOCT_LOG_BACKUP_DISABLED=0
XBOCT_LOG_ACTIVITY_KEEP_DAYS=365
