{
	"name": "xboct-log",
	"displayName": "Xboct Log",
	"description": "Открывает борд xboct-log во вкладке редактора.",
	"version": "0.4.0",
	"type": "commonjs",
	"publisher": "xboct-log",
	"license": "MIT",
	"icon": "media/icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/Ku6epXBOCTuK/xboct-log.git",
		"directory": "vscode-extension"
	},
	"engines": {
		"vscode": "^1.90.0"
	},
	"categories": [
		"Other"
	],
	"main": "./out/extension.js",
	"activationEvents": [
		"onWebviewPanel:xboctLog"
	],
	"contributes": {
		"commands": [
			{
				"command": "xboctLog.open",
				"title": "Xboct Log: Open Board"
			},
			{
				"command": "xboctLog.reload",
				"title": "Xboct Log: Reload",
				"icon": "$(refresh)"
			},
			{
				"command": "xboctLog.start",
				"title": "Xboct Log: Start Server"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "xboctLog",
					"title": "Xboct Log",
					"icon": "media/icon.svg"
				}
			]
		},
		"views": {
			"xboctLog": [
				{
					"id": "xboctLog.board",
					"name": "Xboct Log",
					"icon": "media/icon.svg"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "xboctLog.board",
				"contents": "Борд открывается в отдельной вкладке редактора.\n[Открыть борд](command:xboctLog.open)"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "xboctLog.reload",
					"when": "activeWebviewPanelId == xboctLog",
					"group": "navigation"
				}
			]
		},
		"configuration": {
			"title": "Xboct Log",
			"properties": {
				"xboctLog.serverUrl": {
					"type": "string",
					"default": "http://127.0.0.1:45881",
					"description": "Адрес приложения xboct-log."
				},
				"xboctLog.autoStart": {
					"type": "boolean",
					"default": true,
					"description": "Запускать локальный сервер xboct-log, если он не отвечает."
				},
				"xboctLog.serverPath": {
					"type": "string",
					"default": "",
					"description": "Путь к xboct-log.cmd или к команде запуска. Пустое значение означает автопоиск: установленное приложение, затем PATH."
				},
				"xboctLog.dataDir": {
					"type": "string",
					"default": "",
					"description": "Папка данных для запускаемого сервера. Пустое значение оставляет выбор за приложением."
				}
			}
		}
	},
	"scripts": {
		"compile": "tsc -p .",
		"watch": "tsc -p . -w",
		"package": "vsce package"
	},
	"devDependencies": {
		"@types/node": "^24",
		"@types/vscode": "^1.90.0",
		"@vscode/vsce": "^4",
		"typescript": "^6.0.3"
	}
}
