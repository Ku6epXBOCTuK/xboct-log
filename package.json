{
	"name": "xboct-log",
	"private": true,
	"version": "0.11.1",
	"type": "module",
	"description": "A local-first task backlog with projects, a kanban board, and SQLite storage.",
	"license": "MIT",
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"dev:seed": "node scripts/dev-seed.mjs",
		"seed:prod": "node scripts/seed-from-prod.mjs",
		"build": "vite build",
		"build:ext": "npm --prefix vscode-extension run compile && npm --prefix vscode-extension run package",
		"package:win": "powershell -ExecutionPolicy Bypass -File scripts/package-win.ps1",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:tokens": "node scripts/check-tokens.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "biome format . && eslint .",
		"format": "biome format --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"contract:generate": "node scripts/contract/generate.mjs",
		"contract:check": "node scripts/contract/generate.mjs --check",
		"e2e:mcp": "node scripts/e2e/mcp.mjs",
		"e2e:ui": "playwright test",
		"e2e": "pnpm e2e:mcp && pnpm e2e:ui",
		"deploy:rust": "powershell -ExecutionPolicy Bypass -File scripts/deploy-rust.ps1",
		"rust:check": "node scripts/rust/check.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@eslint/js": "^10.0.1",
		"@iconify-json/lucide": "^1.2.143",
		"@ku6epxboctuk/ui-kit": "link:C:/+XBOCTuK/+life_projects/ui-kit",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"openapi-typescript": "^7.13.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"markdown-it": "^15.0.3",
		"openapi-fetch": "^0.17.0",
		"zod": "^4.6.7"
	}
}
