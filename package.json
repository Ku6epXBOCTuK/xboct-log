{
	"name": "xboct-log",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"description": "A local-first task backlog with projects, a kanban board, and SQLite storage.",
	"license": "MIT",
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=26"
	},
	"bin": {
		"xboct-log": "bin/xboct-log.mjs"
	},
	"files": [
		"bin",
		"build",
		"migrations",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1",
		"deploy:origin": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1 -Origin",
		"start": "node bin/xboct-log.mjs",
		"dev": "node scripts/dev.mjs",
		"dev:vite": "vite dev",
		"dev:seed": "node scripts/dev-seed.mjs",
		"build": "vite build",
		"build:ext": "npm --prefix vscode-extension run compile && npm --prefix vscode-extension run package",
		"package:win": "powershell -ExecutionPolicy Bypass -File scripts/package-win.ps1",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:tokens": "node scripts/check-tokens.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write . --log-level=warn",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"restore": "node --env-file-if-exists=.env scripts/restore.mjs",
		"migrate": "node scripts/migrate.mjs",
		"migrate:status": "node scripts/migrate.mjs status",
		"migrate:rollback": "node scripts/migrate.mjs rollback",
		"migrate:baseline": "node scripts/migrate.mjs baseline",
		"migrate:unlock": "node scripts/migrate.mjs unlock"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@iconify-json/lucide": "^1.2.143",
		"@ku6epxboctuk/ui-kit": "link:C:/+XBOCTuK/+life_projects/ui-kit",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@ku6epxboctuk/sqlite-up": "^0.6.1",
		"@modelcontextprotocol/server": "^2.3.1",
		"markdown-it": "^15.0.3",
		"mcp-handler": "^2.3.0",
		"neverthrow": "^8.2.0",
		"zod": "^4.6.7"
	}
}
